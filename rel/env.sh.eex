#!/bin/sh
# Sourced by bin/<%= @release.name %> before every release command.
#
# Distributed Erlang setup for the agent mesh. libcluster's Kubernetes.DNS strategy
# resolves the headless Service to pod IPs and connects to `cadmium@<pod ip>`, so each
# agent must be a long-named node called exactly that.
#
#   POD_IP             pod IP from the downward API (status.podIP). When unset (plain
#                      `docker run`, a laptop) the node is cadmium@127.0.0.1, so the
#                      release still boots; it just cannot be reached by other hosts.
#   RELEASE_COOKIE     Erlang cookie; the chart injects it from a Secret. Every agent
#                      must share it. (Without it the build-time releases/COOKIE is used.)
#   CADMIUM_DIST_PORT  the single TCP port Erlang distribution listens on (default 9100)
#                      so it can be declared as a containerPort and NetworkPolicy'd.
#                      epmd itself listens on 4369.

export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
export RELEASE_NODE="${RELEASE_NODE:-<%= @release.name %>@${POD_IP:-127.0.0.1}}"

# Only the long-running node gets the pinned listen port. `remote`, `rpc`, `stop` and
# `pid` start a short-lived hidden node in the same network namespace: it must not try
# to bind the port the agent already holds.
case "${RELEASE_COMMAND:-}" in
  start | start_iex | daemon | daemon_iex)
    dist_port="${CADMIUM_DIST_PORT:-9100}"
    dist_flags="-kernel inet_dist_listen_min ${dist_port} inet_dist_listen_max ${dist_port}"
    ;;
  *)
    dist_flags=""
    ;;
esac

# An IPv6 pod IP (single-stack v6 cluster, or v6-primary dual-stack) needs the
# distribution carrier switched to IPv6, for the agent and for helper nodes alike.
# Peer *discovery* on such clusters additionally needs libcluster to resolve AAAA
# records - see docs/deploy.md.
case "${RELEASE_NODE}" in
  *@*:*) dist_flags="-proto_dist inet6_tcp ${dist_flags}" ;;
esac

if [ -n "${dist_flags}" ]; then
  export ERL_AFLAGS="${dist_flags}${ERL_AFLAGS:+ ${ERL_AFLAGS}}"
fi
