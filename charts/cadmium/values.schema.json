{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cadmium chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "score": {
      "description": "0-100. `helm --set` passes decimals as strings (use --set-json for a real number), so numeric strings are accepted too.",
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 100 },
        { "type": "string", "pattern": "^(100(\\.0+)?|[0-9]{1,2}(\\.[0-9]+)?)$" }
      ]
    }
  },
  "properties": {
    "global": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dryRun": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "sampleIntervalMs": { "type": "integer", "minimum": 100 },
        "broadcastIntervalMs": { "type": "integer", "minimum": 100 },
        "staleAfterMs": { "type": "integer", "minimum": 1000 },
        "evaluateIntervalMs": { "type": "integer", "minimum": 1000 },
        "hotThreshold": { "$ref": "#/definitions/score" },
        "spreadThreshold": { "$ref": "#/definitions/score" },
        "sustainedMs": { "type": "integer", "minimum": 0 },
        "nodeCooldownMs": { "type": "integer", "minimum": 0 },
        "workloadCooldownMs": { "type": "integer", "minimum": 0 },
        "maxEvictionsPerCycle": { "type": "integer", "minimum": 0 },
        "excludedNamespaces": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
        },
        "leaseName": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
        "leaseDurationSeconds": { "type": "integer", "minimum": 5 },
        "source": { "enum": ["cgroup", "synthetic"] },
        "kubeClient": { "enum": ["http", "fake"] }
      }
    },
    "discord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 }
      }
    },
    "hostPaths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cgroup": { "type": "string", "pattern": "^/" },
        "cgroupMountPropagation": { "enum": ["None", "HostToContainer"] },
        "proc": { "type": "string", "pattern": "^/" }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "host": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path"],
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "clusterDomain": { "type": "string", "minLength": 1 }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "secretKeyBase": { "type": "string", "pattern": "^(|.{64,})$" },
        "erlangCookie": { "type": "string", "pattern": "^[A-Za-z0-9_=+-]*$" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "create": { "type": "boolean" } }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "dashboardFrom": { "type": "array", "items": { "type": "object" } }
      }
    },
    "updateStrategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["RollingUpdate", "OnDelete"] },
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxUnavailable": { "type": ["integer", "string"] },
            "maxSurge": { "type": ["integer", "string"] }
          }
        }
      }
    },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "affinity": { "type": "object" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "startup": { "type": "object" },
        "liveness": { "type": "object" },
        "readiness": { "type": "object" }
      }
    },
    "tmpSizeLimit": { "type": "string" },
    "extraEnv": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "commonLabels": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
